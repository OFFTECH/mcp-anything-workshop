// Workshop exercise 04: a quarter of a simplified four-layer cable cross-section (our own geometry). Units: mm.
// TEACHING SIMPLIFICATION: bonded, homogeneous, linear-elastic layers; see README.md.
// Mesh and export:  gmsh cable_quarter.geo -2 -format inp -o cable_mesh_gmsh.inp
DefineConstant[ R1 = {10, Name "Parameters/Core radius [mm]"} ];
DefineConstant[ R2 = {18, Name "Parameters/Insulation outer radius [mm]"} ];
DefineConstant[ R3 = {20, Name "Parameters/Sheath outer radius [mm]"} ];
DefineConstant[ R4 = {24, Name "Parameters/Armour outer radius [mm]"} ];
DefineConstant[ LC = {0.8, Name "Parameters/Element size [mm]"} ];
Point(1) = {0, 0, 0, LC};
Point(2) = {R1, 0, 0, LC};
Point(3) = {0, R1, 0, LC};
Point(4) = {R2, 0, 0, LC};
Point(5) = {0, R2, 0, LC};
Point(6) = {R3, 0, 0, LC};
Point(7) = {0, R3, 0, LC};
Point(8) = {R4, 0, 0, LC};
Point(9) = {0, R4, 0, LC};
Line(1) = {1, 2};
Line(2) = {2, 4};
Line(3) = {4, 6};
Line(4) = {6, 8};
Line(5) = {1, 3};
Line(6) = {3, 5};
Line(7) = {5, 7};
Line(8) = {7, 9};
Circle(9) = {2, 1, 3};
Circle(10) = {4, 1, 5};
Circle(11) = {6, 1, 7};
Circle(12) = {8, 1, 9};
Curve Loop(1) = {1, 9, -5};
Plane Surface(1) = {1};
Curve Loop(2) = {2, 10, -6, -9};
Plane Surface(2) = {2};
Curve Loop(3) = {3, 11, -7, -10};
Plane Surface(3) = {3};
Curve Loop(4) = {4, 12, -8, -11};
Plane Surface(4) = {4};
Physical Surface("CORE") = {1};
Physical Surface("INSULATION") = {2};
Physical Surface("SHEATH") = {3};
Physical Surface("ARMOUR") = {4};
Physical Surface("CABLE") = {1, 2, 3, 4};
Physical Curve("SYMY") = {1, 2, 3, 4};
Physical Curve("SYMX") = {5, 6, 7, 8};
Physical Curve("OUTER") = {12};
Physical Point("P_CORE") = {2};
Physical Point("P_OUTER") = {8};
Mesh.ElementOrder = 2;
Mesh.SaveGroupsOfElements = -100;
Mesh.SaveGroupsOfNodes = -111;
